# The build is mounted at the project root via the .htaccess internal rewrite,
# so the public base is /vehicle_manual/ even though the files live in
# frontend/dist. The router basename follows this value automatically.
VITE_BASE_PATH=/vehicle_manual/
# Relative on purpose: the browser resolves it against the current origin, so one
# build works on the LAN IP and on the public domain with no CORS dependency.
# The API lives at the Laravel public root; see backend/.htaccess note.
VITE_API_URL=/vehicle_manual/backend/public/api
