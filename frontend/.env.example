# Base path the built app is served from. Leave as / for a vhost on the domain
# root or for the dev server. Set to a subfolder path when dropping the build
# into Apache, e.g. /vehicle_manual/frontend/dist/
VITE_BASE_PATH=/

# API base URL baked into dist/runtime-config.js. Leave empty to call /api on the
# same origin, which is what the dev and preview proxies expect. Set it when the
# API is served from a different origin, and add that frontend origin to
# CORS_ALLOWED_ORIGINS in the backend .env.
VITE_API_URL=
