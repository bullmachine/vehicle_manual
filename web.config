<?xml version="1.0" encoding="UTF-8"?>
<!--
  BULL vehicle manual portal, IIS equivalent of .htaccess.

  The same folder is served by two servers:

    Apache (XAMPP)  on the LAN, via .htaccess  -> http://192.168.1.49/vehicle_manual/
    IIS 10.0        externally, via this file  -> https://projects.bullmachine.in/vehicle_manual/

  Apache reads .htaccess and ignores this file. IIS reads this file and ignores
  .htaccess. Neither affects the other, and both are scoped to the vehicle_manual
  directory only, so no sibling project in htdocs is touched.

  Rules run top to bottom and stopProcessing ends the chain on the first match.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!--
          1. Dotfiles and dot directories: .htaccess, .env, .git, .env.production.
          IIS already hides these, so this rule is belt and braces for the case
          where that protection is switched off at the server level.
        -->
        <rule name="Deny dotfiles" stopProcessing="true">
          <match url="(^|/)\." />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!--
          2. Public files from the build output. The built index.html references
          /vehicle_manual/assets/... and /vehicle_manual/favicon.svg, but the
          files physically live in frontend/dist, so they are mapped here.

          This is an explicit allowlist on purpose. The obvious alternative,
          checking whether a file exists under frontend/dist, depends on
          {APPL_PHYSICAL_PATH}, which resolves differently depending on whether
          /vehicle_manual is an IIS application or a virtual directory. That
          cannot be verified from the build machine, so it is avoided.

          Adding a new file to the root of frontend/dist means adding it here too.
          assets/ is a wildcard, so hashed bundles never need changing.
        -->
        <rule name="Serve built assets" stopProcessing="true">
          <match url="^(assets/.*|favicon\.svg|icons\.svg|runtime-config\.js)$" />
          <action type="Rewrite" url="frontend/dist/{R:0}" />
        </rule>

        <!--
          3. Hand the API to the framework front controller.

          Without this, IIS looks for a file at /backend/public/api/... and
          returns 404, because an extensionless path never reaches the PHP
          handler. Only requests that resolve to a .php file get executed.

          If PATH_INFO is not populated correctly on the rewritten request, the
          fix is to drop this rule and point VITE_API_URL at
          /vehicle_manual/backend/public/index.php/api instead, which needs no
          rewriting and works on both servers.
        -->
        <rule name="Laravel API" stopProcessing="true">
          <match url="^backend/public/api/(.*)$" />
          <action type="Rewrite" url="backend/public/index.php/api/{R:1}" appendQueryString="true" />
        </rule>

        <!--
          4. Security lock.

          A path that resolves to a real file or directory inside the project is
          someone probing for source, not an application route, so it is refused
          with 404. This is a denylist-free check: anything that exists on disk
          is covered, including files added in future, so there is nothing to keep
          in sync.

          This is what stops backend/composer.json, frontend/src/, storage/logs,
          vendor/ and friends from being publicly downloadable. The Apache side
          gets the same result from the equivalent rules in .htaccess.

          The pattern is .+ rather than .* so the empty path is excluded, leaving
          /vehicle_manual/ itself to fall through to the SPA rule below.
        -->
        <rule name="Deny source files" stopProcessing="true">
          <match url="^(?!backend/public/api/).+" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!--
          5. Everything left is a client side route. Serve the entry point so the
          router can resolve it. Internal rewrite, so the address bar keeps the
          clean path and nothing appears to redirect.
        -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="frontend/dist/index.html" />
        </rule>

      </rules>
    </rewrite>

    <!--
      Caching.

      Without an explicit Cache-Control, IIS sends none at all and browsers fall
      back to heuristic caching, roughly ten percent of the file's age. That is
      what caused a blank page after a deploy: the browser kept serving a cached
      index.html whose bundle filenames no longer existed, and the old bundle
      paths answer 404 as text/html, which a module script refuses to execute.

      clientCache is used here rather than httpProtocol/customHeaders on purpose:

        - customHeaders is applied to every response in the scope, including the
          API. That appended this value to the Cache-Control the framework had
          already set, producing a single malformed field reading
          "no-cache, private,no-cache, must-revalidate".
        - clientCache belongs to the static file module, so it is not applied to
          responses coming back through the PHP handler. The API keeps exactly
          the one Cache-Control the framework sets.

      max-age=0 means the browser must revalidate before every reuse, which is
      the behaviour wanted here. Revalidation is a cheap 304, and it only applies
      to static files.

      The entry document needs this and gets it for free even though it is
      reached by an internal rewrite from arbitrary URLs such as /, /admin/login
      and /contact, because the header is produced when the rewritten target
      frontend/dist/index.html is served.

      A consequence is that hashed bundles under assets/ also revalidate. Giving
      them a one year immutable cache would need a per-path override, and
      <location> is not honoured in this configuration because /vehicle_manual is
      a virtual directory rather than an IIS application. Left as a documented
      follow-up rather than a rule that silently does nothing.
    -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" />
    </staticContent>

    <!--
      Manual PDFs can be up to 200 MB. IIS rejects request bodies above 30 MB by
      default, so allow 250 MB (headroom for the multipart form fields). The
      application itself enforces the exact limit set in Admin > Settings.
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="262144000" />
      </requestFiltering>
    </security>

  </system.webServer>

</configuration>
