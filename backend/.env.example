APP_NAME="BULL Vehicle Manual Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vehicle_manual
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:4173,localhost:8000,127.0.0.1:8000

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@manual.example.com
MAIL_FROM_NAME="${APP_NAME}"

PHONE_DEFAULT_REGION=IN
# Comma-separated ISO 3166-1 alpha-2 allowlist. Leave empty to accept every country.
# ALLOWED_PHONE_REGIONS=IN,AE
CUSTOMER_SESSION_MINUTES=120
MANUAL_MAX_FILE_SIZE=209715200
PDF_RENDERER=imagick
PDF_RENDERER_REQUIRED=false

ADMIN_NAME="BULL Administrator"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="ChangeMe123!"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SAP (ABAP) machine data API, synced nightly by `php artisan machines:sync`.
SAP_MACHINE_API_URL=http://172.16.1.132:8000/sap/bc/zsap_data_api
SAP_MACHINE_API_USERNAME=
SAP_MACHINE_API_PASSWORD=
SAP_MACHINE_API_TYPE=UM_API
SAP_MACHINE_PLANTS=1500
SAP_MACHINE_API_TIMEOUT=60
SAP_MACHINE_SYNC_DAYS=7
